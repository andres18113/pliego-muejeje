[Unit]
Description=Check PLIEGO backup freshness
OnFailure=pliego-backup-alert.service
[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/pliego/backup/freshness.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
