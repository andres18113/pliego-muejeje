[Unit]
Description=Encrypted off-site PLIEGO PostgreSQL backup
After=postgresql@18-main.service network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target
OnFailure=pliego-backup-alert.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=PATH=/usr/lib/postgresql/18/bin:/usr/bin:/bin
EnvironmentFile=/etc/pliego-backup/backup.conf
LoadCredential=s3.json:/etc/pliego-backup/s3.json
# PID1 opens only the existing lock, without truncation/creation/permission change.
# Requires systemd >=253 (Ubuntu 24.04 ships 255). The wrapper stays postgres.
OpenFile=/run/lock/pliego-deploy.lock:deploy-lock:read-only
ExecStart=/opt/pliego/backup/deploy-lock.py
StateDirectory=pliego-backup
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pliego-backup
StandardOutput=journal
StandardError=journal
