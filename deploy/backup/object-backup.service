[Unit]
Description=Opt-in encrypted PLIEGO invoice object backup
After=postgresql@18-main.service network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target
OnFailure=pliego-backup-alert.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=PATH=/usr/lib/postgresql/18/bin:/usr/bin:/bin
Environment=GNUPGHOME=/var/lib/pliego-object-backup/gpg
EnvironmentFile=/etc/pliego-backup/object-backup.conf
LoadCredential=object-source.json:/etc/pliego-backup/object-source.json
LoadCredential=object-target.json:/etc/pliego-backup/object-target.json
OpenFile=/run/lock/pliego-deploy.lock:deploy-lock:read-only
ExecStart=/opt/pliego/backup/deploy-lock.py --job invoices
StateDirectory=pliego-object-backup
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pliego-object-backup
StandardOutput=journal
StandardError=journal
